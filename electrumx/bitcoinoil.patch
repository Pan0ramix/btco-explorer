+    # AuxPoW data only when version bit 8 is set, which the node enforces.
+    NAME = "BitcoinOil"
+    SHORTNAME = "BTCO"
+    NET = "mainnet"
+    P2PKH_VERBYTE = bytes.fromhex("1a")
+    P2SH_VERBYTES = (bytes.fromhex("19"),)
